---
import Button from './Button.astro';
import { url } from '../utils/url';

interface ImageData {
  src: string;
  alt: string;
}

interface CallToAction {
  href: string;
  label: string;
}

interface Props {
  title: string;
  text: string;
  image: ImageData;
  cta?: CallToAction;
  reverse?: boolean;
}

const {
  title,
  text,
  image,
  cta,
  reverse = false
} = Astro.props;
---

<div class:list={['split-feature', { 'split-feature--reverse': reverse }]}>
  <div class="split-feature__media">
    <img
      src={url(image.src)}
      alt={image.alt}
      width="900"
      height="900"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="split-feature__content">
    <h2>{title}</h2>
    <p>{text}</p>

    {cta && (
      <Button href={cta.href} class="split-feature__cta">
        {cta.label}
      </Button>
    )}
  </div>
</div>