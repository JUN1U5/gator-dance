---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Classes from '../components/Classes.astro';
import Schedule from '../components/Schedule.astro';
import Teacher from '../components/Teacher.astro';
import Gallery from '../components/Gallery.astro';
import Journal from '../components/Journal.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { businessSchema, websiteSchema } from '../utils/schema';

import Sponsors from '../components/Sponsors.astro';
import DanceTeam from '../components/DanceTeam.astro';
import FAQ from '../components/FAQ.astro';

---

<BaseLayout schema={[websiteSchema(Astro.site), businessSchema(Astro.site)]}>
  <Hero />
  <Classes />
  <Schedule />
  <DanceTeam />
  <Gallery />
  <Teacher />
  <Sponsors />
  <Journal />
  <FAQ />
  <ContactCTA />
</BaseLayout>