---
import Button from './Button.astro';
import { url } from '../utils/url';

interface Props {
  title: string;
  text: string;
  image: {
    src: string;
    alt: string;
  };
  cta?: {
    href: string;
    label: string;
  };
}

const { title, text, image, cta } = Astro.props;
---

<div class="approach-detail">
  <div class="approach-detail__grid">
    <div class="approach-detail__media">
      <img
        src={url(image.src)}
        alt={image.alt}
        width="900"
        height="900"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="approach-detail__content">
      <h3>{title}</h3>
      <p>{text}</p>

      {cta && (
        <Button href={cta.href} class="approach-detail__cta">
          {cta.label}
        </Button>
      )}
    </div>
  </div>
</div>