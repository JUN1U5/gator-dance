---
import Icon from './Icon.astro';
import { site } from '../config/site';
import { url } from '../utils/url';
---

<a class="logo" href={url('/')} aria-label={`${site.name} home`}>
  <Icon name="logo" size={30} />
  <span class="logo__word">{site.logoText}</span>
</a>

