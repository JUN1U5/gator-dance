---
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import ApproachDetail from '../components/ApproachDetail.astro';
import { approach } from '../data/home';
import { url } from '../utils/url';
---

<section class="section approach" id="approach" aria-labelledby="approach-title">
  <div class="container">
    <SectionHeading
      id="approach-title"
      title={approach.title}
      intro={approach.intro}
    />

    <div class="approach__grid">
      <div class="approach__media">
        <img
          src={url(approach.content.image.src)}
          alt={approach.content.image.alt}
          width="900"
          height="900"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="approach__content">
        <h3>{approach.content.title}</h3>
        <p>{approach.content.text}</p>

        <Button href={approach.content.cta.href} class="approach__cta">
          {approach.content.cta.label}
        </Button>
      </div>
    </div>

    <ApproachDetail
      title={approach.detail.title}
      text={approach.detail.text}
      image={approach.detail.image}
      cta={approach.detail.cta}
    />
  </div>
</section>