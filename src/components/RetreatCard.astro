---
import type { Retreat } from '../types';
import Icon from './Icon.astro';
import { url } from '../utils/url';

interface Props {
  retreat: Retreat;
}

const { retreat } = Astro.props;
---

<article class="retreat">
  <img src={url(retreat.image.src)} alt={retreat.image.alt} width="800" height="1000" loading="lazy" decoding="async" />
  <div>
    <h3>{retreat.title}</h3>
    <p>{retreat.description}</p>
    <div class="retreat__row">
      <a class="link-arrow" href={url(retreat.cardURL)}>
        {retreat.ctaLabel}<span class="sr-only"> {retreat.title}</span><Icon name="arrow-up" size={14} />
      </a>
    </div>
  </div>
</article>
