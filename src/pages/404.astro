---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <PageHero
    full
    image={{ src: '/images/dance-purple_invert.jpg', alt: '' }}
    eyebrow="404"
    title="Off the Mat"
    words={[{ text: 'Back' }, { text: 'Stage', serif: true }]}
    lead="We didn't stick the landing. This page must be in the wings. But the show must go on, so let's try again."
  >
    <div class="page-hero__actions">
      <Button href="/" variant="light">Back to Home</Button>
      <Button href="/contact" variant="glass">Contact the Dance Dept</Button>
    </div>
  </PageHero>
</BaseLayout>
