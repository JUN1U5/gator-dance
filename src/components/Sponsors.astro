---
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import SponsorCard from './SponsorCard.astro';
import { sponsors } from '../data/sponsors';
import { sponsorsSection } from '../data/home';
---

<section class="section section--mist" id="sponsors" aria-labelledby="sponsors-title">
  <div class="container">
    <SectionHeading id="sponsors-title" title={sponsorsSection.title} intro={sponsorsSection.intro}>
      {sponsorsSection.cta && <Button href={sponsorsSection.cta.href} variant="line">{sponsorsSection.cta.label}</Button>}
    </SectionHeading>
    <div class="sponsors__grid">
      {sponsors.map((sponsor) => <SponsorCard sponsor={sponsor} />)}
    </div>
  </div>
</section>
