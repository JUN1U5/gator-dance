---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Classes from '../components/Classes.astro';
import Schedule from '../components/Schedule.astro';
import Program from '../components/Program.astro';
import Teacher from '../components/Teacher.astro';
import Testimonials from '../components/Testimonials.astro';
import Gallery from '../components/Gallery.astro';
import Journal from '../components/Journal.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { businessSchema, websiteSchema } from '../utils/schema';

import Coaches from '../components/Coaches.astro';
import DanceTeam from '../components/DanceTeam.astro';
import FAQ from '../components/FAQ.astro';

---

<BaseLayout schema={[websiteSchema(Astro.site), businessSchema(Astro.site)]}>
  <Hero />
  <Classes />
  <Schedule />
  <DanceTeam />
  <Gallery />
  <Teacher />
  <Coaches />
  <Journal />
  <FAQ />
  <ContactCTA />
</BaseLayout>