---
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import CoachCard from './CoachCard.astro';
import { coaches } from '../data/coaches';
import { sponsorsSection } from '../data/home';
---

<section class="section section--mist" id="sponsors" aria-labelledby="sponsors-title">
  <div class="container">
    <SectionHeading id="coaches-title" title={sponsorsSection.title} intro={sponsorsSection.intro}>
      {sponsorsSection.cta && <Button href={sponsorsSection.cta.href} variant="line">{sponsorsSection.cta.label}</Button>}
    </SectionHeading>
    <div class="coaches__grid">
      {coaches.map((coach) => <CoachCard coach={coach} />)}
    </div>
  </div>
</section>
