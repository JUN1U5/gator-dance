---
import SectionHeading from './SectionHeading.astro';
import { schedule } from '../data/schedule';
import { scheduleSection } from '../data/home';
//import { site } from '../config/site';
import { url } from '../utils/url';

//const initial = 0;
---

<section class="section" id="schedule" aria-labelledby="schedule-title" data-schedule>
  <div class="container">
    <SectionHeading id="schedule-title" title={scheduleSection.title} intro={scheduleSection.intro}>
    </SectionHeading>
    <div class="schedule__wrap">
          <table class="schedule__table">
            <caption class="sr-only">Event schedule</caption>
            <thead class="sr-only">
              <tr>
                <th scope="col">Date</th>
                <th scope="col">Time</th>
                <th scope="col">Event</th>
                <th scope="col">Location</th>
                <th scope="col">Tickets</th>
              </tr>
            </thead>
            <tbody>
              {schedule.map((entry) => (
                <tr>
                  <td><div class="schedule__time">{entry.date}<small>{entry.year}</small></div></td>
                  <td><div class="schedule__sponsor">{entry.time}</div></td>
                  <td>
                    <div class="schedule__class">{entry.eventName}</div>
                    {entry.addDetail && <span class="schedule__level">{entry.addDetail}</span>}
                  </td>
                  <td class="schedule__sponsor">{entry.location}</td>
                 <td>
                   {entry.bookingUrl ? (
                    <a class="btn btn--line" href={url(entry.bookingUrl)}>
                      {scheduleSection.reserveLabel}
                     <span class="sr-only"> {entry.eventName}, {entry.time} </span>
                    </a>
                  ) : null}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
    </div>

    <p class="schedule__note">{scheduleSection.note}</p>
  </div>
</section>
